# Copier ce fichier en ".env" puis adapter les valeurs.
# Ne jamais commiter le fichier .env.

# Port HTTP d'écoute du service
PORT=3002

# Chemin du fichier SQLite (relatif au dossier du service, ou absolu)
DB_PATH=./data/orders.db

# URL de base du product-service (sans slash final).
# En conteneur, ce sera le nom du service, ex : http://product-service:3001
PRODUCT_SERVICE_URL=http://localhost:3001

# Délai max (ms) d'un appel HTTP vers product-service
REQUEST_TIMEOUT_MS=5000

# Origine(s) autorisée(s) par CORS, séparées par des virgules ("*" = toutes)
CORS_ORIGIN=*
